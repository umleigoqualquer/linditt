# Supabase (obrigatório)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2 (obrigatório para upload de fotos)
R2_ACCOUNT_ID=
R2_BUCKET=linditt
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# JWT (obrigatório — troque por um valor aleatório grande)
JWT_SECRET=troque-este-segredo-por-um-valor-grande-e-aleatorio

# URL pública do site (necessário para webhook da SumUp)
SITE_URL=https://sualoja.netlify.app

# SumUp (deixe em branco até ter as chaves)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Melhor Envio (opcional — sem isso usa frete fixo)
MELHORENVIO_TOKEN=
MELHORENVIO_EMAIL=
MELHORENVIO_SANDBOX=

# WhatsApp Cloud API (opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# SMTP via .env (alternativa ao painel — o painel tem prioridade)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_LOJA=

# NUNCA ligue em produção
SUMUP_MODO_TESTE=
